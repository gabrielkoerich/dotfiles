#!/usr/bin/env bash
# Tracks coding agents in tmux panes by reading their screens, so agents behind ssh need no install
set -uo pipefail

PATH="$PATH:/opt/homebrew/bin:/usr/local/bin"
interval=${TMUX_AGENTS_INTERVAL:-2}
ssh_config=${TMUX_AGENTS_SSH_CONFIG:-$HOME/.ssh/config}
agent_cmds='^(claude|codex|opencode)$'
ssh_cmds='^(ssh|mosh-client)$'
sep=$'\x1f'
blocked_re='Do you want to|Would you like to run|Allow command\?|Permission required|Allow once|❯ 1\. Yes'
working_re='… \([0-9]+[hms]|esc to interrupt|esc interrupt'

# Reads a screen on stdin, prints blocked or working, or nothing when no agent is busy
classify() {
  local screen
  screen=$(grep -v '^[[:space:]]*$' | tail -n 15)
  if [[ $screen =~ $blocked_re ]]; then
    echo blocked
  elif [[ $screen =~ $working_re ]]; then
    echo working
  fi
}

# Prints every Host alias in an ssh config, following Include and skipping patterns
ssh_hosts() {
  local file=$1 kw rest words w f
  if [[ ! -r $file ]]; then
    return 0
  fi

  while read -r kw rest; do
    read -r -a words <<<"$rest"
    case $kw in
      [Hh][Oo][Ss][Tt])
        for w in "${words[@]}"; do
          if [[ $w != *[*?!]* ]]; then
            echo "$w"
          fi
        done
        ;;
      [Ii][Nn][Cc][Ll][Uu][Dd][Ee])
        for w in "${words[@]}"; do
          w=${w/#\~/$HOME}
          if [[ $w != /* ]]; then
            w=$HOME/.ssh/$w
          fi

          for f in $w; do
            ssh_hosts "$f"
          done
        done
        ;;
    esac
  done <"$file"
}

# Folds the OSC 7501 states of a pane into ours, the most urgent one wins
program_status() {
  case " $1 " in
    *" blocked "* | *" error "*) echo blocked ;;
    *" working "*) echo working ;;
    *) echo idle ;;
  esac
}

notify() {
  if command -v osascript >/dev/null; then
    osascript -e 'on run argv' \
      -e 'display notification (item 2 of argv) with title (item 1 of argv) sound name "Glass"' \
      -e 'end run' "$1" "$2" >/dev/null 2>&1 &
  elif command -v notify-send >/dev/null; then
    notify-send "$1" "$2" &
  fi
}

scan() {
  local panes id win cmd prev cur visible place pss title state alert
  panes=$(tmux list-panes -a -F "#{pane_id}$sep#{window_id}$sep#{pane_current_command}$sep#{@agent_state}$sep#{@agent_alert}$sep#{&&:#{window_active},#{session_attached}}$sep#{session_name}:#{window_index}$sep#{pane_program_status_states}$sep#{pane_title}") || exit 0
  while IFS=$sep read -r id win cmd prev cur visible place pss title; do
    state=
    # OSC 7501 states need a tmux that keeps them, stock tmux leaves the field empty and the screen decides
    if [[ -n $pss && ( $cmd =~ $agent_cmds || $cmd =~ $ssh_cmds ) ]]; then
      state=$(program_status "$pss")
    elif [[ $cmd =~ $agent_cmds || $cmd =~ $ssh_cmds || $title == *✳* ]]; then
      state=$(tmux capture-pane -p -t "$id" | classify)
      # The title keeps ✳ after Claude exits, so only trust it behind ssh where the command hides the agent
      if [[ -z $state ]] && { [[ $cmd =~ $agent_cmds ]] || [[ $cmd =~ $ssh_cmds && ( $title == *✳* || -n $prev ) ]]; }; then
        state=idle
      fi
    fi

    if [[ $state != "$prev" ]]; then
      if [[ -n $state ]]; then
        tmux set -p -t "$id" @agent_state "$state"
      else
        tmux set -pu -t "$id" @agent_state
      fi

      alert=
      if [[ $state == blocked ]]; then
        alert=blocked
      elif [[ $prev == working && $state == idle ]]; then
        alert=done
      fi

      if [[ -n $alert && $visible != 1 ]]; then
        tmux set -w -t "$win" @agent_alert "$alert"
        notify "${title#✳ }" "$place $( [[ $alert == blocked ]] && echo 'needs you' || echo 'finished')"
      elif [[ $state == working && -n $cur ]]; then
        tmux set -wu -t "$win" @agent_alert
      fi
    fi

    if [[ $visible == 1 && -n $cur ]]; then
      tmux set -wu -t "$win" @agent_alert 2>/dev/null
    fi
  done <<<"$panes"
}

watch() {
  local pid
  pid=$(tmux show -gqv @agent_watch_pid)
  if [[ -n $pid ]] && kill -0 "$pid" 2>/dev/null; then
    exit 0
  fi

  tmux set -g @agent_watch_pid $$
  # tmux reports a run -b job killed by a signal, so stop quietly
  trap 'exit 0' TERM
  while true; do
    scan
    sleep "$interval"
  done
}

# One fuzzy list of agents, sessions, windows and ssh hosts, Enter jumps there
pick() {
  local client=$1 icon out key target kind name
  out=$(
    {
      tmux list-panes -a -F "#{@agent_state}$sep#{pane_id}$sep#{pane_title}$sep#{session_name}:#{window_index} #{window_name}" |
        while IFS=$sep read -r state id title place; do
          case $state in
            (blocked) icon='!' ;;
            (working) icon='⠿' ;;
            (idle) icon='●' ;;
            (*) continue ;;
          esac
          printf '%s%s%s agent    %s  %s\n' "$state" "$sep" "pane:$id$sep$icon" "${title#✳ }" "$place"
        done | sort -t "$sep" -k1,1 | cut -d "$sep" -f2-
      tmux list-sessions -F "session:#{session_name}$sep  session  #{session_name} (#{session_windows} windows)"
      tmux list-windows -a -F "pane:#{pane_id}$sep  window   #{session_name}:#{window_index} #{window_name}"
      ssh_hosts "$ssh_config" | awk '!seen[$0]++' | while read -r name; do
        printf 'ssh:%s%s  server   %s\n' "$name" "$sep" "$name"
      done
    } | fzf --delimiter "$sep" --with-nth 2 --expect ctrl-s --reverse --no-sort \
      --header 'enter: go   ctrl-s: server in a new session'
  ) || return 0

  key=$(sed -n 1p <<<"$out")
  target=$(sed -n 2p <<<"$out" | cut -d "$sep" -f1)
  kind=${target%%:*}
  name=${target#*:}
  case $kind in
    pane) tmux switch-client -c "$client" -t "$name" \; select-window -t "$name" \; select-pane -t "$name" ;;
    session) tmux switch-client -c "$client" -t "$name" ;;
    ssh)
      if [[ $key == ctrl-s ]]; then
        tmux new-session -d -s "$name" "ssh $name" \; switch-client -c "$client" -t "$name"
      else
        tmux new-window -t "$(tmux display -p -c "$client" '#{session_name}'):" -n "$name" "ssh $name"
      fi
      ;;
  esac
}

case ${1:-} in
  watch) watch ;;
  stop) kill "$(tmux show -gqv @agent_watch_pid)" 2>/dev/null ;;
  pick) pick "${2:-}" ;;
  classify) classify ;;
  hosts) ssh_hosts "$ssh_config" ;;
  *) echo "usage: tmux-agents watch|stop|pick <client>|classify|hosts" >&2; exit 2 ;;
esac

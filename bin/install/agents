#!/usr/bin/env bash

set -euo pipefail

# ~/.claude/CLAUDE.md is the original, mackup backs it up with the claude-code app
src="$HOME/.claude/CLAUDE.md"

if [ ! -f "$src" ]; then
  echo "error: $src not found, run mackup restore first" >&2
  exit 1
fi

for target in "$HOME/.codex/AGENTS.md" "$HOME/.config/opencode/AGENTS.md"; do
  mkdir -p "$(dirname "$target")"
  if [ -L "$target" ] && [ "$(readlink "$target")" = "$src" ]; then
    continue
  fi

  if [ -e "$target" ] || [ -L "$target" ]; then
    trash "$target"
  fi

  ln -s "$src" "$target"
  echo "Linked $target -> $src"
done

#!/usr/bin/env bash
set -euo pipefail

src="${1:-}"
out="${2:-}"
recipient="${AGE_RECIPIENT:-}"

if [[ -z "$src" || -z "$out" ]]; then
  echo "usage: encrypt-dir <src-dir> <output.tar.age>" >&2
  exit 2
fi

if [[ -z "$recipient" && -n "${AGE_KEY_FILE:-}" ]]; then
  recipient="$(age-keygen -y "$AGE_KEY_FILE")"
elif [[ -z "$recipient" ]]; then
  recipient="$(passbox exec --stdin age/dotfiles -- age-keygen -y)"
fi

tmp_tar="$(mktemp /tmp/dotfiles-enc.XXXXXX.tar)"
trap 'rm -f "$tmp_tar"' EXIT

tar -cf "$tmp_tar" -C "$(dirname "$src")" "$(basename "$src")"
age -r "$recipient" -o "$out" "$tmp_tar"
echo "encrypted dir: $out"

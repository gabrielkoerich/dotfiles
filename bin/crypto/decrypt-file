#!/usr/bin/env bash
set -euo pipefail

in="${1:-}"
out="${2:-}"

if [[ -z "$in" || -z "$out" ]]; then
  echo "usage: decrypt-file <input.age> <output>" >&2
  exit 2
fi

if [[ -n "${AGE_KEY_FILE:-}" ]]; then
  age --decrypt -i "$AGE_KEY_FILE" -o "$out" "$in"
else
  passbox exec --stdin age/dotfiles -- age --decrypt -i - -o "$out" "$in"
fi
echo "decrypted: $out"
